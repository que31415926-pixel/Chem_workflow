    {
      "step": "balance",
      "id": "closure",
      "data": "examples/material.csv"
    },
    "handoff"
  ],
  "qm": {
    "temperature_K": 303.15,
    "crest_solvent": "toluene",
    "solvents": {
      "default": {
        "cpcm": "toluene"
      }
    },
    "jobs": [
      {
        "species": "E_butene",
        "mult": 1
      }
    ]
  },
  "paired": {
    "practical": 50,
    "gap": 10,
    "min_blocks": 3
  }
}
