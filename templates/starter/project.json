{
  "schema_version": 1,
  "title": "E/Z 异构化 · 教学模板",
  "workflow": [
    "prepare",
    {
      "step": "fit",
      "id": "estimate",
      "data": "examples/observations.csv"
    },
    {
      "step": "simulate",
      "id": "forecast",
      "calibrated": "@estimate/calibrated.json"
